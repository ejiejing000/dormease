# Copy to backend/.env. Never commit the filled-in file and never ship the demo credentials.
PORT=9000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=dormease

# Required in production, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Absolute origin used inside invitation and receipt links sent by email.
PUBLIC_APP_URL=http://localhost:9000

# How long a tenant password invitation stays usable (single-use regardless).
INVITATION_HOURS=72
# How long a held reservation keeps its bed.
HOLD_MINUTES=30
# Charged once by the overdue sweep on a bill past its due date.
LATE_FEE_AMOUNT=100
# A ticket untouched for this many hours is escalated once.
TICKET_SLA_HOURS=48

# Background jobs (standard cron, validated on start; an invalid value is ignored with a warning).
HOLD_EXPIRY_CRON=*/5 * * * *
OVERDUE_BILLS_CRON=0 1 * * *
TICKET_ESCALATION_CRON=*/15 * * * *
EMAIL_OUTBOX_CRON=*/10 * * * *

# Leave EMAIL_HOST empty to keep emails in the email_outbox table only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@dormease.local
